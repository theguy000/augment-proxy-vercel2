{
  "version": 2,
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/proxy"
    },
    {
      "source": "/authorize",
      "destination": "/api/proxy"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/proxy"
    },
    {
      "source": "/",
      "destination": "/api/proxy"
    }
  ]
}
